<UserControl x:Class="DayPlannerApp.Views.TaskEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DayPlannerApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Title -->
            <TextBlock Grid.Row="0" 
                      Text="{Binding IsEditMode, Converter={StaticResource BoolToEditModeConverter}}" 
                      FontSize="24" 
                      FontWeight="Bold" 
                      Margin="0,0,0,20"/>
            
            <!-- Description (Markdown Editor) -->
            <GroupBox Grid.Row="1" Header="Description (Markdown)" Margin="0,0,0,15">
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                        Height="150" 
                        AcceptsReturn="True" 
                        TextWrapping="Wrap" 
                        VerticalScrollBarVisibility="Auto"
                        FontFamily="Consolas"
                        Padding="5"/>
            </GroupBox>
            
            <!-- Task Type -->
            <GroupBox Grid.Row="2" Header="Task Type" Margin="0,0,0,15">
                <ComboBox SelectedValue="{Binding TaskTypeId}" 
                         DisplayMemberPath="Content" 
                         SelectedValuePath="Tag"
                         Height="30">
                    <ComboBoxItem Content="Personal Projects" Tag="1"/>
                    <ComboBoxItem Content="Learning" Tag="2"/>
                    <ComboBoxItem Content="Work" Tag="3"/>
                    <ComboBoxItem Content="Must Do" Tag="4"/>
                </ComboBox>
            </GroupBox>
            
            <!-- Tags -->
            <GroupBox Grid.Row="3" Header="Tags" Margin="0,0,0,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Selected Tags -->
                    <TextBlock Grid.Row="0" Text="Selected Tags:" Margin="0,0,0,5"/>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding SelectedTags}" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2196F3" 
                                       CornerRadius="3" 
                                       Padding="8,4" 
                                       Margin="3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" Foreground="White" Margin="0,0,5,0"/>
                                        <Button Content="×" 
                                               Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"
                                               Background="Transparent"
                                               Foreground="White"
                                               BorderThickness="0"
                                               FontWeight="Bold"
                                               Cursor="Hand"
                                               Padding="2"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <!-- Add Tag -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <TextBox x:Name="NewTagTextBox" Width="200" Height="30" Margin="0,0,10,0"/>
                        <Button Content="Add Tag" 
                               Command="{Binding AddTagCommand}"
                               CommandParameter="{Binding ElementName=NewTagTextBox, Path=Text}"
                               Width="80" 
                               Height="30"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
            
            <!-- Deadlines -->
            <GroupBox Grid.Row="4" Header="Deadlines" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Deadline Date:" Margin="0,0,0,5"/>
                        <DatePicker SelectedDate="{Binding DeadlineDate}" Height="30"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Deadline Time:" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding DeadlineTime, StringFormat='hh\\:mm'}" 
                                Height="30" 
                                ToolTip="Format: HH:mm"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
            
            <!-- Urgency -->
            <GroupBox Grid.Row="5" Header="Urgency Level" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Slider Grid.Column="0" 
                           Value="{Binding UrgencyLevel}" 
                           Minimum="0" 
                           Maximum="10" 
                           TickFrequency="1" 
                           IsSnapToTickEnabled="True"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                    
                    <TextBlock Grid.Column="1" 
                              Text="{Binding UrgencyLevel}" 
                              FontSize="18" 
                              FontWeight="Bold"
                              VerticalAlignment="Center"
                              Width="30"
                              TextAlignment="Center"/>
                </Grid>
            </GroupBox>
            
            <!-- Coordinates -->
            <GroupBox Grid.Row="6" Header="Importance and Complexity" Margin="0,0,0,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Importance -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Importance:" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" 
                               Value="{Binding Importance}" 
                               Minimum="0" 
                               Maximum="100" 
                               TickFrequency="5" 
                               IsSnapToTickEnabled="True"
                               VerticalAlignment="Center"
                               Margin="10,0"/>
                        <TextBlock Grid.Column="2" 
                                  Text="{Binding Importance, StringFormat='{}{0:F0}'}" 
                                  VerticalAlignment="Center"
                                  TextAlignment="Center"/>
                    </Grid>
                    
                    <!-- Complexity -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Complexity:" VerticalAlignment="Center"/>
                        <Slider Grid.Column="1" 
                               Value="{Binding Complexity}" 
                               Minimum="0" 
                               Maximum="100" 
                               TickFrequency="5" 
                               IsSnapToTickEnabled="True"
                               VerticalAlignment="Center"
                               Margin="10,0"/>
                        <TextBlock Grid.Column="2" 
                                  Text="{Binding Complexity, StringFormat='{}{0:F0}'}" 
                                  VerticalAlignment="Center"
                                  TextAlignment="Center"/>
                    </Grid>
                </Grid>
            </GroupBox>
            
            <!-- Action Buttons -->
            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Save" 
                       Command="{Binding SaveCommand}" 
                       Width="100" 
                       Height="35" 
                       Margin="0,0,10,0"
                       Background="#4CAF50"
                       Foreground="White"
                       FontWeight="Bold"/>
                <Button Content="Cancel" 
                       Command="{Binding CancelCommand}" 
                       Width="100" 
                       Height="35" 
                       Margin="0,0,10,0"/>
                <Button Content="Delete" 
                       Command="{Binding DeleteCommand}" 
                       Width="100" 
                       Height="35"
                       Background="#F44336"
                       Foreground="White"
                       FontWeight="Bold"
                       Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:BoolToEditModeTextConverter x:Key="BoolToEditModeConverter"/>
    </UserControl.Resources>
</UserControl>

<UserControl x:Class="DayPlannerApp.Views.TimeTrackerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DayPlannerApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="400">
    <Border BorderBrush="#2196F3" 
            BorderThickness="2" 
            CornerRadius="10" 
            Padding="20"
            Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" 
                             ShadowDepth="3" 
                             Opacity="0.2"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Title -->
            <TextBlock Grid.Row="0" 
                      Text="Time Tracker" 
                      FontSize="20" 
                      FontWeight="Bold" 
                      HorizontalAlignment="Center"
                      Margin="0,0,0,15"/>
            
            <!-- Time Display -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Elapsed Time -->
                <Border Grid.Row="0" 
                       Background="#E3F2FD" 
                       CornerRadius="5" 
                       Padding="15,10"
                       Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" 
                                  Text="Work Time:" 
                                  FontSize="14" 
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"/>
                        
                        <TextBlock Grid.Column="1" 
                                  Text="{Binding DisplayTime}" 
                                  FontSize="24" 
                                  FontWeight="Bold"
                                  Foreground="#2196F3"
                                  FontFamily="Consolas"/>
                    </Grid>
                </Border>
                
                <!-- Break Time -->
                <Border Grid.Row="1" 
                       Background="#FFF3E0" 
                       CornerRadius="5" 
                       Padding="15,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" 
                                  Text="Break Time:" 
                                  FontSize="14" 
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"/>
                        
                        <TextBlock Grid.Column="1" 
                                  Text="{Binding BreakDisplayTime}" 
                                  FontSize="24" 
                                  FontWeight="Bold"
                                  Foreground="#FF9800"
                                  FontFamily="Consolas"/>
                    </Grid>
                </Border>
            </Grid>
            
            <!-- Status Indicator -->
            <Border Grid.Row="2" 
                   CornerRadius="5" 
                   Padding="10,5"
                   Margin="0,0,0,15"
                   HorizontalAlignment="Center">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTracking}" Value="True">
                                <Setter Property="Background" Value="#4CAF50"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsTracking}" Value="False">
                                <Setter Property="Background" Value="#9E9E9E"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsOnBreak}" Value="True">
                                <Setter Property="Background" Value="#FF9800"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                
                <TextBlock FontSize="12" 
                          FontWeight="Bold" 
                          Foreground="White">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOnBreak}" Value="True">
                                    <Setter Property="Text" Value="● ON BREAK"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTracking}" Value="True">
                                    <Setter Property="Text" Value="● TRACKING"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTracking}" Value="False">
                                    <Setter Property="Text" Value="● STOPPED"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
            
            <!-- Control Buttons -->
            <UniformGrid Grid.Row="3" 
                        Columns="2" 
                        Rows="2"
                        HorizontalAlignment="Stretch">
                <!-- Start Button -->
                <Button Content="▶ Start" 
                       Command="{Binding StartTrackingCommand}" 
                       Height="40"
                       Margin="0,0,5,5"
                       Background="#4CAF50"
                       Foreground="White"
                       FontWeight="Bold"
                       FontSize="14"/>
                
                <!-- Stop Button -->
                <Button Content="■ Stop" 
                       Command="{Binding StopTrackingCommand}" 
                       Height="40"
                       Margin="5,0,0,5"
                       Background="#F44336"
                       Foreground="White"
                       FontWeight="Bold"
                       FontSize="14"/>
                
                <!-- Start Break Button -->
                <Button Content="☕ Start Break" 
                       Command="{Binding StartBreakCommand}" 
                       Height="40"
                       Margin="0,5,5,0"
                       Background="#FF9800"
                       Foreground="White"
                       FontWeight="Bold"
                       FontSize="14"/>
                
                <!-- End Break Button -->
                <Button Content="↻ End Break" 
                       Command="{Binding EndBreakCommand}" 
                       Height="40"
                       Margin="5,5,0,0"
                       Background="#2196F3"
                       Foreground="White"
                       FontWeight="Bold"
                       FontSize="14"/>
            </UniformGrid>
        </Grid>
    </Border>
</UserControl>

<UserControl x:Class="DayPlannerApp.Views.DailyStatsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:DayPlannerApp.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="400">
    <UserControl.Resources>
        <converters:PercentageToWidthConverter x:Key="PercentageToWidthConverter"/>
    </UserControl.Resources>
    <Border Background="#FAFAFA" 
           BorderBrush="#E0E0E0" 
           BorderThickness="1" 
           CornerRadius="5" 
           Padding="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Title -->
            <TextBlock Grid.Row="0" 
                      Text="Daily Statistics" 
                      FontSize="18" 
                      FontWeight="Bold"
                      Margin="0,0,0,15"/>
            
            <!-- Total Time Worked -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Total Time Worked: " 
                          FontSize="14" 
                          FontWeight="SemiBold"
                          Margin="0,0,5,0"/>
                <TextBlock FontSize="14" 
                          FontWeight="Bold"
                          Foreground="#4CAF50">
                    <Run Text="{Binding TotalTimeWorkedToday.Hours, Mode=OneWay}"/>
                    <Run Text="h "/>
                    <Run Text="{Binding TotalTimeWorkedToday.Minutes, Mode=OneWay}"/>
                    <Run Text="m"/>
                </TextBlock>
            </StackPanel>
            
            <!-- Active and Completed Tasks -->
            <Grid Grid.Row="2" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Active Tasks: " 
                              FontSize="12" 
                              Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding ActiveTasksCount}" 
                              FontSize="12" 
                              FontWeight="Bold"
                              Foreground="#2196F3"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Completed Today: " 
                              FontSize="12" 
                              Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding CompletedTasksCount}" 
                              FontSize="12" 
                              FontWeight="Bold"
                              Foreground="#4CAF50"/>
                </StackPanel>
            </Grid>
            
            <!-- Time Breakdown Title -->
            <TextBlock Grid.Row="3" 
                      Text="Time Breakdown:" 
                      FontSize="14" 
                      FontWeight="SemiBold"
                      Margin="0,0,0,10"/>
            
            <!-- Time Breakdown List -->
            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding TaskTimeBreakdown}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E0E0E0" 
                                   BorderThickness="0,0,0,1" 
                                   Padding="0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Task Description and Duration -->
                                    <Grid Grid.Row="0" Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" 
                                                  Text="{Binding TaskDescription}" 
                                                  FontSize="12"
                                                  TextTrimming="CharacterEllipsis"/>
                                        
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding FormattedDuration}" 
                                                      FontSize="12" 
                                                      FontWeight="SemiBold"
                                                      Margin="0,0,5,0"/>
                                            <TextBlock FontSize="12" 
                                                      Foreground="#757575">
                                                <Run Text="("/>
                                                <Run Text="{Binding PercentageOfDay, StringFormat='{}{0:F0}'}"/>
                                                <Run Text="%)"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                    
                                    <!-- Progress Bar -->
                                    <Border Grid.Row="1" 
                                           Background="#E0E0E0" 
                                           Height="6" 
                                           CornerRadius="3">
                                        <Border Background="#4CAF50" 
                                               CornerRadius="3"
                                               HorizontalAlignment="Left"
                                               Width="{Binding PercentageOfDay, Converter={StaticResource PercentageToWidthConverter}}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>

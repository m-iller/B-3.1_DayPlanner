<UserControl x:Class="DayPlannerApp.Views.CoordinateControllerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DayPlannerApp.Views"
             xmlns:converters="clr-namespace:DayPlannerApp.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Title -->
        <TextBlock Grid.Row="0" 
                  Text="Coordinate Controller" 
                  FontSize="28" 
                  FontWeight="Bold" 
                  Margin="0,0,0,15"/>
        
        <!-- Controls -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="0" 
                   Content="Load Tasks" 
                   Command="{Binding LoadTasksCommand}" 
                   Width="120" 
                   Height="35"
                   Margin="0,0,10,0"/>
            
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Filter Range - Importance:" 
                          VerticalAlignment="Center" 
                          Margin="0,0,10,0"/>
                <TextBox Text="{Binding MinImportance}" Width="50" Margin="0,0,5,0"/>
                <TextBlock Text="to" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Text="{Binding MaxImportance}" Width="50" Margin="0,0,15,0"/>
                
                <TextBlock Text="Complexity:" 
                          VerticalAlignment="Center" 
                          Margin="0,0,10,0"/>
                <TextBox Text="{Binding MinComplexity}" Width="50" Margin="0,0,5,0"/>
                <TextBlock Text="to" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Text="{Binding MaxComplexity}" Width="50" Margin="0,0,15,0"/>
                
                <Button Content="Apply Filter" 
                       Command="{Binding FilterByRangeCommand}" 
                       Width="100" 
                       Height="30"/>
            </StackPanel>
        </Grid>
        
        <!-- Coordinate Grid -->
        <Border Grid.Row="2" 
               BorderBrush="#E0E0E0" 
               BorderThickness="2" 
               Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Y-Axis Label (Importance) -->
                <TextBlock Grid.Row="1" 
                          Grid.Column="0" 
                          Text="Importance" 
                          FontSize="16" 
                          FontWeight="SemiBold"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="-90"/>
                    </TextBlock.LayoutTransform>
                </TextBlock>
                
                <!-- X-Axis Label (Complexity) -->
                <TextBlock Grid.Row="2" 
                          Grid.Column="1" 
                          Text="Complexity" 
                          FontSize="16" 
                          FontWeight="SemiBold"
                          HorizontalAlignment="Center"
                          Margin="0,10,0,0"/>
                
                <!-- Canvas for Task Positioning -->
                <Canvas Grid.Row="1" 
                       Grid.Column="1" 
                       x:Name="CoordinateCanvas"
                       Background="#FAFAFA"
                       Margin="10">
                    <!-- Grid Lines -->
                    <Canvas.Resources>
                        <Style TargetType="Line">
                            <Setter Property="Stroke" Value="#E0E0E0"/>
                            <Setter Property="StrokeThickness" Value="1"/>
                        </Style>
                    </Canvas.Resources>
                    
                    <!-- Vertical Grid Lines -->
                    <Line X1="0" Y1="0" X2="0" Y2="{Binding ActualHeight, ElementName=CoordinateCanvas}"/>
                    <Line X1="{Binding ActualWidth, ElementName=CoordinateCanvas, Converter={StaticResource PercentageConverter}, ConverterParameter=0.25}" 
                         Y1="0" 
                         X2="{Binding ActualWidth, ElementName=CoordinateCanvas, Converter={StaticResource PercentageConverter}, ConverterParameter=0.25}" 
                         Y2="{Binding ActualHeight, ElementName=CoordinateCanvas}"/>
                    <Line X1="{Binding ActualWidth, ElementName=CoordinateCanvas, Converter={StaticResource PercentageConverter}, ConverterParameter=0.5}" 
                         Y1="0" 
                         X2="{Binding ActualWidth, ElementName=CoordinateCanvas, Converter={StaticResource PercentageConverter}, ConverterParameter=0.5}" 
                         Y2="{Binding ActualHeight, ElementName=CoordinateCanvas}"/>
                    <Line X1="{Binding ActualWidth, ElementName=CoordinateCanvas, Converter={StaticResource PercentageConverter}, ConverterParameter=0.75}" 
                         Y1="0" 
                         X2="{Binding ActualWidth, ElementName=CoordinateCanvas, Converter={StaticResource PercentageConverter}, ConverterParameter=0.75}" 
                         Y2="{Binding ActualHeight, ElementName=CoordinateCanvas}"/>
                    <Line X1="{Binding ActualWidth, ElementName=CoordinateCanvas}" 
                         Y1="0" 
                         X2="{Binding ActualWidth, ElementName=CoordinateCanvas}" 
                         Y2="{Binding ActualHeight, ElementName=CoordinateCanvas}"/>
                    
                    <!-- Horizontal Grid Lines -->
                    <Line X1="0" Y1="0" X2="{Binding ActualWidth, ElementName=CoordinateCanvas}" Y2="0"/>
                    <Line X1="0" 
                         Y1="{Binding ActualHeight, ElementName=CoordinateCanvas, Converter={StaticResource PercentageConverter}, ConverterParameter=0.25}" 
                         X2="{Binding ActualWidth, ElementName=CoordinateCanvas}" 
                         Y2="{Binding ActualHeight, ElementName=CoordinateCanvas, Converter={StaticResource PercentageConverter}, ConverterParameter=0.25}"/>
                    <Line X1="0" 
                         Y1="{Binding ActualHeight, ElementName=CoordinateCanvas, Converter={StaticResource PercentageConverter}, ConverterParameter=0.5}" 
                         X2="{Binding ActualWidth, ElementName=CoordinateCanvas}" 
                         Y2="{Binding ActualHeight, ElementName=CoordinateCanvas, Converter={StaticResource PercentageConverter}, ConverterParameter=0.5}"/>
                    <Line X1="0" 
                         Y1="{Binding ActualHeight, ElementName=CoordinateCanvas, Converter={StaticResource PercentageConverter}, ConverterParameter=0.75}" 
                         X2="{Binding ActualWidth, ElementName=CoordinateCanvas}" 
                         Y2="{Binding ActualHeight, ElementName=CoordinateCanvas, Converter={StaticResource PercentageConverter}, ConverterParameter=0.75}"/>
                    <Line X1="0" 
                         Y1="{Binding ActualHeight, ElementName=CoordinateCanvas}" 
                         X2="{Binding ActualWidth, ElementName=CoordinateCanvas}" 
                         Y2="{Binding ActualHeight, ElementName=CoordinateCanvas}"/>
                    
                    <!-- Tasks -->
                    <ItemsControl ItemsSource="{Binding Tasks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style>
                                <Setter Property="Canvas.Left">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource CoordinateToCanvasConverter}">
                                            <Binding Path="Complexity"/>
                                            <Binding ElementName="CoordinateCanvas" Path="ActualWidth"/>
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Canvas.Top">
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource InvertedCoordinateToCanvasConverter}">
                                            <Binding Path="Importance"/>
                                            <Binding ElementName="CoordinateCanvas" Path="ActualHeight"/>
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2196F3" 
                                       CornerRadius="5" 
                                       Padding="10,5"
                                       Cursor="Hand"
                                       ToolTip="{Binding Description}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="5" 
                                                         ShadowDepth="2" 
                                                         Opacity="0.3"/>
                                    </Border.Effect>
                                    <TextBlock Text="{Binding Description}" 
                                              Foreground="White" 
                                              FontSize="11"
                                              MaxWidth="150"
                                              TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </Grid>
        </Border>
    </Grid>
    
    <UserControl.Resources>
        <converters:PercentageConverter x:Key="PercentageConverter"/>
        <converters:CoordinateToCanvasConverter x:Key="CoordinateToCanvasConverter"/>
        <converters:InvertedCoordinateToCanvasConverter x:Key="InvertedCoordinateToCanvasConverter"/>
    </UserControl.Resources>
</UserControl>
